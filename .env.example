# Variable names only. Never put real values in Git, a ZIP, or chat.
# The separate Manus Webdev project injects its own managed OAuth and MySQL values.
PORT=3000
REVIEW_PUBLIC_ORIGIN=
DATABASE_URL=
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=

# Supply these two independently through the review project's protected secret-input card.
QURAN_CLIENT_ID=
QURAN_CLIENT_SECRET=
QURAN_ENVIRONMENT=production

# Owner identity is seeded once by scripts/bootstrap-review-owner.mjs from a verified
# OAuth account ID using an operator-only environment variable. Never enable a public claim.

# Podcast foundation: default hard-off. Do not add an ElevenLabs key until the owner approves
# a bounded measurement run. Storage remains an injected private object-store adapter.
PODCAST_RENDER_MODE=disabled
PODCAST_COST_MEASUREMENT_EPISODE_ID=
PODCAST_COST_MEASUREMENT_APPROVED=false
PODCAST_PRODUCTION_APPROVED=false
PODCAST_DAILY_CREDIT_CAP=0
PODCAST_AUDIO_STORE_PROVIDER=
PODCAST_AUDIO_STORE_APPROVED=false
PODCAST_REPORT_ADAPTER_CONNECTED=false
PODCAST_FFMPEG_WORKER_APPROVED=false
