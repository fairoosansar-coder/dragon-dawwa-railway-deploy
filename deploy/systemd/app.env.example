# NAMES ONLY. The real /etc/dragon-dawwa/app.env must be created on the NEW
# approved VM, owned by root, mode 0600, never committed, uploaded to a ticket,
# pasted into chat or copied from the existing Site.
# The systemd manager reads this file; application processes receive its values.
#
# Required server mode:
# AUTH_PROVIDER=tailscale-serve
# REVIEW_BIND_HOST=127.0.0.1
# REVIEW_PUBLIC_ORIGIN=https://<approved-device>.<approved-tailnet>.ts.net
# REVIEW_APP_ID=<unique private application identifier, not the Manus ID>
# REVIEW_SESSION_SECRET=<new 256-bit random secret, protected host entry>
# PORT=3000
#
# Isolated local MySQL 8 connection and socket, NEVER review/production D1:
# DATABASE_URL=mysql://<least-privilege-app-user>:<urlencoded-password>@localhost/dragon_dawwa_private_<unique>
# REVIEW_LOCAL_DB_SOCKET=/run/mysqld/mysqld.sock
#
# Existing external provider credentials, securely re-entered for this host:
# QURAN_CLIENT_ID=<protected Quran Foundation production client ID>
# QURAN_CLIENT_SECRET=<protected Quran Foundation production client secret>
# QURAN_ENVIRONMENT=production
# GEMINI_API_KEY=<protected Google Gemini API key>
#
# Keep paid study disabled until the owner validates the human account, source
# rights, daily hard caps and actual terms. Leave STUDY_LIVE_CANARY unset;
# a bare flag without one exact verified ID also fails closed. An explicit
# owner database usageLimits setting is initially zero for all actions.
# STUDY_LIVE_CANARY=true                   # only after owner pilot approval
# STUDY_LIVE_CANARY_USER_ID=tailnet:<one verified login>
# STUDY_USER_DAILY_TEXT_REQUESTS=<positive hard cap, e.g. 2>
# STUDY_GLOBAL_DAILY_TEXT_REQUESTS=<positive hard cap, e.g. 2>
# STUDY_USER_DAILY_TTS_REQUESTS=<positive hard cap, e.g. 1>
# STUDY_GLOBAL_DAILY_TTS_REQUESTS=<positive hard cap, e.g. 1>
# STUDY_GLOBAL_AUDIO_CONCURRENCY=<bounded integer 0..100>
# Values of 0 for *_DAILY_*REQUESTS are NOT a disable switch: leave the
# canary OFF and the owner usageLimits at zero to disable paid generation.
#
# DD_PUBLIC_READ_MODE must remain unset (anonymous published-only option OFF).
