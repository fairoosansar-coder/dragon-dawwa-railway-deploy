# Example variable NAMES only; never commit a filled copy or enter secrets in chat.
# /etc/dragon-dawwa/backup.env must be owned root:dragon-dawwa mode 0640.
DATABASE_URL=<new_isolated_mysql_app_dsn>
AUTH_PROVIDER=tailscale-serve
REVIEW_BIND_HOST=127.0.0.1
REVIEW_LOCAL_DB_SOCKET=/run/mysqld/mysqld.sock
DD_S3_BUCKET=<approved_private_bucket>
DD_S3_ENDPOINT=https://nbg1.your-objectstorage.com
DD_BACKUP_PASSPHRASE_FILE=/etc/dragon-dawwa/secrets/backup-passphrase
AWS_SHARED_CREDENTIALS_FILE=/etc/dragon-dawwa/secrets/s3-credentials
AWS_CONFIG_FILE=/etc/dragon-dawwa/secrets/aws-config
AWS_DEFAULT_REGION=eu-central
DD_BACKUP_TMP_ROOT=/run/dragon-dawwa-backup
