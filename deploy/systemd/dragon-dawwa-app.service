[Unit]
Description=Dragon Dawwa private learning service (Tailscale Serve backend)
Documentation=file:/opt/dragon-dawwa/current/docs/DEPLOYMENT_DECISION.md
Requires=mysql.service
After=network-online.target mysql.service tailscaled.service
Wants=network-online.target tailscaled.service
StartLimitIntervalSec=600
StartLimitBurst=6

[Service]
Type=simple
User=dragon-dawwa
Group=dragon-dawwa
WorkingDirectory=/opt/dragon-dawwa/current
EnvironmentFile=/etc/dragon-dawwa/app.env
ExecStartPre=/usr/bin/test -S /run/mysqld/mysqld.sock
ExecStart=/usr/bin/node /opt/dragon-dawwa/current/server/index.mjs
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=2G
TasksMax=128
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
